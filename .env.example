# PostHog is optional and disabled until all three values are configured.
VITE_ANALYTICS_ENABLED=false

# Use the public Project API Key from PostHog project settings (never a Personal API Key).
VITE_POSTHOG_KEY=

# Use the ingestion host shown by PostHog for the project.
# EU Cloud example: https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Optional deployed backend endpoint; never place an AI provider key in VITE_*.
VITE_FRIDGE_ASSISTANT_URL=

# Server only: use a Gemini Free Tier project with billing disabled (budget: 0).
# These values belong in the Worker's secret store, never VITE_* or GitHub Pages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
